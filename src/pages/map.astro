 --><!-- Leaflet css -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<div class="header">
  <img src="/Ams.png" alt="Amsterdam Logo" />
  <h1 class="titel">BBQ Plekken Amsterdam</h1>
</div>

<div class="layout">
  <!-- Kaartkolom -->
  <div class="panel">
    <p class="beschrijving">
      Deze app toont alle BBQ locaties in Amsterdam op basis van open data van
      de gemeente.
    </p>
    <p class="beschrijving-2">Klik op een marker om meer details te zien.</p>

    <div id="map"></div>
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    ></script>

    <div class="kleurcode">
      <h3>Legenda</h3>
      <ul>
        <!-- Span voor kleurblokjes ja nee -->
        <li><span class="nee"></span> Rood: BBQ niet toegestaan</li>
        <li><span class="ja"></span> Geel: BBQ toegestaan</li>
        <li><span class="onbekend"></span> Grijs: Status onbekend</li>
      </ul>
    </div>
  </div>

  <!-- Detailskolom -->
  <div class="laatste-bezoek">
    <h3>Laatst bekeken</h3>
    <p>Naam: <span id="laatsteBezoekNaam">—</span></p>
    <p>Status: <span id="laatsteBezoekStatus">—</span></p>
    <p>Toelichting: <span id="laatsteBezoekUitleg">—</span></p>
    <button id="opslaanBtn">Sla op als favoriet</button>

    <h3>Opgeslagen plekken</h3>
    <ul id="favorietenLijst"></ul>
    <button id="wisBtn">Wis alle favorieten</button>
  </div>
</div>

<script>
  // @ts-nocheck

  // LEAFLET — kaart initialisatie
  // Setview=Startpositie op de kaart. 13 zoomniveau
  const map = L.map("map").setView([52.37, 4.9], 13);

  //Achtergrondskaart
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap",
  }).addTo(map);

  // GEOLOCATION API
  // https://developer.mozilla.org/en-US/docs/Web/API/Geolocation_API
  const options = {
    enableHighAccuracy: true,
    timeout: 5000,
    maximumAge: 0,
  };

  // locatie gebruiker ophalen en bij toestaan positie centreren+marker
  navigator.geolocation.getCurrentPosition(
    function (position) {
      // latitude is hoe ver je noord/zuid bent
      // longitude hoe ver je oost/west bent
      const latitude = position.coords.latitude;
      const longitude = position.coords.longitude;
      map.setView([latitude, longitude], 13);
      L.marker([latitude, longitude])
        .addTo(map)
        .bindPopup("📍 Jouw locatie")
        .openPopup();
    },
    // bij locatie weigeren foutmelding
    //chatgpt
    function (err) {
      // +  stukken text aan elkaar plakken dus error+message
      console.warn("ERROR(" + err.code + "): " + err.message);
      // console.warn tonen als een waarschuwing in de browser
    }
  );

  // GEMEENTE AMSTERDAM OPEN GEODATA API
  // BBQ data geholpen door Jad
  // https://maps.amsterdam.nl/open_geodata/geojson_lnglat.php?KAARTLAAG=BBQ&THEMA=bbq
  fetch(
    "https://maps.amsterdam.nl/open_geodata/geojson_lnglat.php?KAARTLAAG=BBQ&THEMA=bbq"
  )
    .then(function (res) {
      return res.json();
    })
    .then(function (data) {
      const group = L.layerGroup().addTo(map);
      // geholpen door Jad
      data.features.forEach(function (place) {
        let item = place.geometry.coordinates[0][0];
        if (item.length !== 2) item = item[0];

        // GeoJSON: [longitude, latitude] — omgekeerd van Leaflet
        const lat = item[1];
        const lng = item[0];

        // Data uit API properties
        // || als dit leeg is de alternatief tekst gebruiken
        const naam = place.properties.Naam || "Onbekend";
        const status = place.properties.Status || "Onbekend";
        const uitleg = place.properties.Toelichting || "";

        // Kleur op basis van status uit API
        let kleur;
        // === checkt of 2 dingen dezelfde zijn
        if (status === "Verbod") kleur = "#EC0000";
        else if (status === "Restricties") kleur = "#ffff00";
        else kleur = "#888";

        // locatiecirckels
        const cirkel = L.circleMarker([lat, lng], {
          radius: 6,
          color: kleur,
          fillColor: kleur,
          // https://developer.mozilla.org/en-US/docs/Web/SVG/Reference/Attribute/fill-opacity
          // doorzichtigheid
          fillOpacity: 0.8,
          weight: 2,
        })

          // popup koppelen aan cirkel uit de api
          .addTo(group)
          .bindPopup(
            "<div>" +
              "<strong>" +
              naam +
              "</strong><br>" +
              "Status: " +
              status +
              "<br>" +
              "Toelichting: " +
              uitleg +
              "</div>"
          );

        // hover effect
        // Chatgpt
        cirkel.on("mouseover", function () {
          this.setRadius(12);
        });
        cirkel.on("mouseout", function () {
          this.setRadius(6);
        });

        // LOCALSTORAGE — setItem() om aangeklikte plek op te slaan
        // https://developer.mozilla.org/en-US/docs/Web/API/Window/localStorage
        // constante gemaakt met 3 gegevens-> opslaan in localstorage-> omzetten naar tekst
        cirkel.on("click", function () {
          const plekData = { naam: naam, status: status, uitleg: uitleg };
          // JSON.stringify zet het object om naar tekst want localStorage snapt alleen tekst
          localStorage.setItem("laatsteBezoek", JSON.stringify(plekData));
          // textcontent  zet de tekst in een HTML element

          document.getElementById("laatsteBezoekNaam").textContent = naam;
          document.getElementById("laatsteBezoekStatus").textContent = status;
          document.getElementById("laatsteBezoekUitleg").textContent = uitleg;
        });
      });
    });

  // LOCALSTORAGE — getItem() om opgeslagen plek te laden bij pagina laden
  // https://developer.mozilla.org/en-US/docs/Web/API/Window/localStorage
  // LOCALSTORAGE — getItem() om opgeslagen plek te laden bij pagina laden
  // Bij het laden van de pagina wordt gekeken of er al een plek opgeslagen is en deze getoond
  const opgeslagen = localStorage.getItem("laatsteBezoek");
  if (opgeslagen) {
    const plekData = JSON.parse(opgeslagen);
    document.getElementById("laatsteBezoekNaam").textContent = plekData.naam;
    document.getElementById("laatsteBezoekStatus").textContent =
      plekData.status;
    document.getElementById("laatsteBezoekUitleg").textContent =
      plekData.uitleg;
  }

  // LOCALSTORAGE — favorietenlijst tonen bij pagina laden
  // met || "[]" krijg ik altijd een array terug
  const opgeslagenLijst = JSON.parse(
    localStorage.getItem("favorieten") || "[]"
  );
  const lijst = document.getElementById("favorietenLijst");

  opgeslagenLijst.forEach(function (f) {
    const li = document.createElement("li");
    li.textContent = f.naam + " — " + f.status;
    lijst.appendChild(li);
  });

  // LOCALSTORAGE — setItem() om favoriet op te slaan via knop
  document.getElementById("opslaanBtn").addEventListener("click", function () {
    const naam = document.getElementById("laatsteBezoekNaam").textContent;
    const status = document.getElementById("laatsteBezoekStatus").textContent;
    const uitleg = document.getElementById("laatsteBezoekUitleg").textContent;

    const bestaandeLijst = JSON.parse(
      // || "[]"  als er nog niets is een lege array gebruiken
      localStorage.getItem("favorieten") || "[]"
    );
    const favoriet = { naam: naam, status: status, uitleg: uitleg };
    bestaandeLijst.push(favoriet);
    localStorage.setItem("favorieten", JSON.stringify(bestaandeLijst));

    // direct toevoegen aan lijst op pagina zonder herladen
    const li = document.createElement("li");
    li.textContent = naam + " — " + status;
    lijst.appendChild(li);
  });

  // MDN localStorage — clear() om alle favorieten te wissen
  document.getElementById("wisBtn").addEventListener("click", function () {
    localStorage.removeItem("favorieten");
    // innerHTML lijst op de pagina leeggemaken
    document.getElementById("favorietenLijst").innerHTML = "";
  });
</script>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-top: 4px solid #ec0000;
    padding: 0.75rem;
    background-color: aliceblue;
  }

  .header img {
    width: 80px;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .titel {
    margin: 0;
    font-size: 1.5rem;
    font-family: sans-serif;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1rem;
    /* volledige schermhoogte vullen minus de header */
    /* https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/calc */
    height: calc(100vh - 80px);
    font-family: sans-serif;
    background: #f5f5f5;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .beschrijving {
    text-align: center;
  }

  .beschrijving-2 {
    text-align: center;
    font-weight: 700;
    color: #ec0000;
    font-size: 0.9rem;
  }

  #map {
    flex: 1;
    border: 3px solid #ec0000;
  }

  .kleurcode {
    background: white;
    padding: 0.75rem 1rem;
    border: 2px solid #ec0000;
    font-size: 14px;
  }

  .kleurcode h3 {
    color: #ec0000;
    margin-bottom: 0.4rem;
    font-size: 14px;
  }

  .kleurcode ul {
    list-style: none;
    display: flex;
    gap: 1rem;
  }

  .kleurcode li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 12px;
  }

  .nee,
  .ja,
  .onbekend {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .nee {
    background-color: #ec0000;
  }
  .ja {
    background-color: #ffff00;
    border: 1px solid #ccc;
  }
  .onbekend {
    background-color: gray;
  }

  .laatste-bezoek {
    background: white;
    border: 3px solid #ec0000;
    padding: 1.5rem;
    font-size: 14px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
  }
  #opslaanBtn {
    margin-top: 0.5rem;
    padding: 8px 16px;
    background: #ec0000;
    color: white;
    border: none;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
  }

  #opslaanBtn:hover {
    background: #b30000;
  }

  .verwijder-btn {
    background: none;
    border: none;
    color: #ec0000;
    cursor: pointer;
    font-size: 13px;
  }

  @media (max-width: 768px) {
    .layout {
      grid-template-columns: 1fr;
      height: auto;
    }

    #map {
      height: 300px;
      flex: none;
    }
  }
</style>
