---
// @ts-nocheck
---

<!-- npm install leaflet
npm install
npm run dev
 -->
<header>
  <label for="site-search">Cafe zoeken</label>
  <input type="search" id="site-search" name="q" />
  <button>Zoeken</button>

  <!-- <img href="" -->
</header>
<!--Container om de leaflet kaart erin te zetten -->
<div id="map"></div>

<!--CSS styling pijltjes, knoppen, zoom, control etc -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<!-- Leaflet library zelf om de kaart te maken en manipuleren -->
<script
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>
<script>
  // @ts-nocheck

  //   L.map maakt de leaflet kaart met de id map//
  //   13 is de zoomlevel aantal steden en straten//
  // .SetView de middenpunt bepalen van de kaart//
  
  const map = L.map("map").setView([51.505, -0.09], 13);
  //   leaflet vertellen welke kaart geladen moet worden//
  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(map);
  //   addTo map voegt de titels toe aan de map//

  // Markers toevoegen//
  var marker = L.marker([51.5, -0.09]).addTo(map);
  marker.bindPopup("<b>Hello world!</b><br>I am a popup.").openPopup();
</script>

<style>
  #map {
    height: 400px;
    margin-top: em;
  }

  header {
    display: flex;
    justify-content: center;
    padding-top: 1em;
    padding-bottom: 2em;
    gap: 1em;
  }
</style>
